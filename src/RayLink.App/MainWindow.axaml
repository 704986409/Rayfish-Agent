<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RayLink.App.MainWindow"
        Width="1180" Height="780"
        MinWidth="980" MinHeight="650"
        Title="AgentLink"
        Background="#F3F3F3"
        FontFamily="Segoe UI, Microsoft YaHei UI, PingFang SC">
  <Window.Styles>
    <!-- Shared neutral palette, with restrained Windows-style accent colors. -->
    <Style Selector="TextBlock.app-brand">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#202020" />
    </Style>
    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#202020" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#707070" />
    </Style>
    <Style Selector="TextBlock.nav-label">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="#404040" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#242424" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#686868" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderBrush" Value="#DADADA" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.nav-item">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Height" Value="42" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.nav-item.selected">
      <Setter Property="Background" Value="#E4E4E4" />
    </Style>
    <Style Selector="Button.nav-item.selected TextBlock.nav-label">
      <Setter Property="Foreground" Value="#202020" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E9E9E9" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.nav-item:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#DCDCDC" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#0F6CBD" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#0F6CBD" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#115EA3" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#115EA3" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#0C4A85" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#242424" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#EAEAEA" />
      <Setter Property="BorderBrush" Value="#E4E4E4" />
      <Setter Property="Foreground" Value="#919191" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#DADADA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#242424" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBox.code">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.surface">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#E5E5E5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.subtle-surface">
      <Setter Property="Background" Value="#F7F7F7" />
      <Setter Property="BorderBrush" Value="#ECECEC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.message">
      <Setter Property="Background" Value="#F3F3F3" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Margin" Value="0,0,56,12" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="MaxWidth" Value="560" />
    </Style>
    <Style Selector="Border.message.local">
      <Setter Property="Background" Value="#EAF2FA" />
      <Setter Property="Margin" Value="56,0,0,12" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Border.status-pill">
      <Setter Property="Background" Value="#EFEFEF" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="Border.status-pill.online">
      <Setter Property="Background" Value="#EAF5EE" />
    </Style>
    <Style Selector="TextBlock.status-text">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#707070" />
    </Style>
    <Style Selector="Border.status-pill.online TextBlock.status-text">
      <Setter Property="Foreground" Value="#107C41" />
    </Style>
    <Style Selector="Border.status-dot">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="#999999" />
    </Style>
    <Style Selector="Border.status-dot.online">
      <Setter Property="Background" Value="#107C41" />
    </Style>
    <!-- Thin rounded scrollbar thumbs; keep the native scrolling behavior. -->
    <Style Selector="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="#B5B5B5" CornerRadius="4" Margin="2" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ScrollBar /template/ Thumb:pointerover /template/ Border">
      <Setter Property="Background" Value="#858585" />
    </Style>
    <Style Selector="ScrollBar /template/ RepeatButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Path.connect-spinner">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="48,*">
    <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*" Margin="24,0">
        <TextBlock Classes="app-brand" Text="AgentLink" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="caption" Text="跨网络 · 点对点通信" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="216,*" IsEnabled="{Binding !IsConnectionDialogOpen}">
      <Border Grid.Column="0" Background="#F3F3F3" BorderBrush="#E5E5E5" BorderThickness="0,0,1,0" Padding="14,18,14,14">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Spacing="2" HorizontalAlignment="Stretch">
            <Button Classes="nav-item" Classes.selected="{Binding IsWorkspacePage}" Command="{Binding NavigateCommand}" CommandParameter="0">
              <TextBlock Classes="nav-label" Text="通信工作区" />
            </Button>
            <Button Classes="nav-item" Classes.selected="{Binding IsRemoteNodesPage}" Command="{Binding NavigateCommand}" CommandParameter="1">
              <TextBlock Classes="nav-label" Text="远程节点" />
            </Button>
            <Button Classes="nav-item" Classes.selected="{Binding IsMessagesPage}" Command="{Binding NavigateCommand}" CommandParameter="2">
              <Grid>
                <TextBlock Classes="nav-label" Text="消息发送" />
                <Border x:Name="UnreadDot" Width="7" Height="7" CornerRadius="4" Background="#D83B3B"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-10,0"
                        IsVisible="{Binding HasUnreadMessages}" />
              </Grid>
            </Button>
            <Button Classes="nav-item" Classes.selected="{Binding IsStatusPage}" Command="{Binding NavigateCommand}" CommandParameter="3">
              <TextBlock Classes="nav-label" Text="节点状态" />
            </Button>
            <Button Classes="nav-item" Classes.selected="{Binding IsRolesPage}" Command="{Binding NavigateCommand}" CommandParameter="5">
              <TextBlock Classes="nav-label" Text="角色设定" />
            </Button>
          </StackPanel>
          <Border Grid.Row="1" Margin="8,28,8,0" BorderBrush="#E5E5E5" BorderThickness="0,1,0,0" Padding="0,16,0,0">
            <StackPanel Spacing="10">
              <TextBlock Classes="caption" Text="当前节点" />
              <Border Classes="subtle-surface" Padding="10">
                <StackPanel Spacing="7">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Border Classes="status-dot" Classes.online="{Binding IsServerStarted}" />
                    <TextBlock Text="{Binding Settings.DisplayName}" TextTrimming="CharacterEllipsis" FontSize="13" Foreground="#242424" />
                  </StackPanel>
                  <TextBlock Text="{Binding NodeStatus}" Classes="caption" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
          <Button Grid.Row="2" Classes="nav-item" Classes.selected="{Binding IsSettingsPage}" Command="{Binding NavigateCommand}" CommandParameter="4">
            <TextBlock Text="⚙" FontSize="20" Foreground="#404040" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
        </Grid>
      </Border>
      <Border Grid.Column="1" Background="#FAFAFA">
        <Grid Margin="28,28,28,24" RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <StackPanel Spacing="4">
              <TextBlock Classes="page-title" Text="{Binding PageTitle}" />
              <TextBlock Classes="caption" Text="{Binding PageSubtitle}" />
            </StackPanel>
            <Border Grid.Column="1" Classes="status-pill" Classes.online="{Binding IsServerStarted}" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Border Classes="status-dot" Classes.online="{Binding IsServerStarted}" />
                <TextBlock Classes="status-text" Text="{Binding ServerStatus}" />
              </StackPanel>
            </Border>
          </Grid>
          <!-- Communication workspace -->
          <ScrollViewer Grid.Row="1" IsVisible="{Binding IsWorkspacePage}" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
              <Border Classes="surface" Padding="22">
                <StackPanel Spacing="10">
                  <TextBlock Classes="section-title" Text="连接概览" />
                  <TextBlock Classes="muted" Text="在这里查看本机服务与远程连接的状态。" />
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,5,0,0">
                    <Border Classes="subtle-surface" Padding="12">
                      <StackPanel Spacing="5">
                        <TextBlock Classes="caption" Text="节点状态" />
                        <TextBlock Text="{Binding NodeStatus}" FontSize="13" Foreground="#242424" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="subtle-surface" Padding="12">
                      <StackPanel Spacing="5">
                        <TextBlock Classes="caption" Text="连接状态" />
                        <TextBlock Text="{Binding ConnectionStatus}" FontSize="13" Foreground="#242424" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="subtle-surface" Padding="12">
                      <StackPanel Spacing="5">
                        <TextBlock Classes="caption" Text="消息数量" />
                        <TextBlock Text="{Binding MessageCount}" FontSize="13" Foreground="#242424" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Classes="surface" Padding="22">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="section-title" Text="快速开始" />
                    <TextBlock Classes="muted" Text="先启动本机 Iroh 服务，再在远程节点页粘贴对方地址。" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="primary" Content="{Binding StartServerText}" Command="{Binding StartServerCommand}" IsEnabled="{Binding CanStartServer}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <!-- Remote nodes -->
          <ScrollViewer Grid.Row="1" IsVisible="{Binding IsRemoteNodesPage}" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
              <Border Classes="surface" Padding="22">
                <StackPanel Spacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="section-title" Text="本机节点" />
                    <TextBlock Classes="muted" Text="请先在通信工作区启动服务，启动后显示本机节点信息。" />
                  </StackPanel>
                  <TextBox Text="{Binding LocalNodeName, Mode=OneWay}" IsReadOnly="True" PlaceholderText="启动后显示设备名称" />
                  <StackPanel Spacing="5">
                    <TextBlock Classes="caption" Text="Endpoint ID" />
                    <TextBox Classes="code" Text="{Binding Settings.LocalEndpointId}" IsReadOnly="True" FontSize="11" />
                  </StackPanel>
                  <StackPanel Spacing="5">
                    <TextBlock Classes="caption" Text="Endpoint 地址" />
                    <TextBox Classes="code" Text="{Binding Settings.LocalEndpointAddress}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="82" FontSize="11" />
                  </StackPanel>
                  <Button Classes="secondary" Content="复制" Command="{Binding CopyEndpointCommand}" IsEnabled="{Binding IsServerStarted}" HorizontalAlignment="Right" />
                  <TextBlock Classes="muted" Text="地址只包含节点公开信息，请勿分享本机 SecretKey。" />
                </StackPanel>
              </Border>
              <Border Classes="surface" Padding="22">
                <StackPanel Spacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="section-title" Text="连接远程节点" />
                    <TextBlock Classes="muted" Text="粘贴对方的 Endpoint 地址即可建立连接。" />
                  </StackPanel>
                  <TextBox Classes="code" Text="{Binding Settings.RemoteEndpointAddress}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="112" PlaceholderText="粘贴 EndpointAddr JSON" FontSize="11" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Button Classes="primary" Content="建立连接" Command="{Binding ConnectCommand}" IsEnabled="{Binding CanConnect}" />
                    <Button Grid.Column="1" Classes="secondary" Content="断开" Command="{Binding DisconnectCommand}" IsEnabled="{Binding IsConnected}" />
                  </Grid>
                  <TextBlock Classes="muted" Text="双方无需在同一局域网。Iroh 会自动尝试点对点连接，必要时使用 Relay。" />
                  <Border Classes="subtle-surface" Padding="12" IsVisible="{Binding HasPendingTrust}">
                    <StackPanel Spacing="8">
                      <TextBlock Text="确认远程节点信任" FontWeight="SemiBold" />
                      <TextBlock Classes="code" Text="{Binding PendingTrustNode}" TextWrapping="Wrap" FontSize="11" />
                      <TextBlock Classes="muted" Text="信任后才会同步对方明确共享的 Agent；对方也必须独立信任本机。" TextWrapping="Wrap" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="primary" Content="信任并同步" Command="{Binding TrustNodeCommand}" />
                        <Button Classes="secondary" Content="拒绝" Command="{Binding RejectNodeCommand}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <!-- Message conversation -->
          <Grid Grid.Row="1" IsVisible="{Binding IsMessagesPage}" RowDefinitions="*,Auto" RowSpacing="14">
            <Border Classes="surface" Padding="22">
              <Grid RowDefinitions="Auto,*,Auto">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="section-title" Text="点对点消息" />
                    <TextBlock Classes="muted" Text="通过 Iroh QUIC 可靠、有序地发送文本消息。" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding ConnectionStatus}" FontSize="11" Foreground="#0F6CBD" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Row="1" IsVisible="{Binding !HasMessages}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                  <TextBlock Text="开始一段对话" FontSize="20" FontWeight="SemiBold" Foreground="#404040" HorizontalAlignment="Center" />
                  <TextBlock Classes="muted" Text="连接远程节点后，即可在下方发送消息。" HorizontalAlignment="Center" />

                </StackPanel>
                <ScrollViewer x:Name="MessageScroll" Grid.Row="1" IsVisible="{Binding HasMessages}" VerticalScrollBarVisibility="Hidden" ScrollChanged="OnMessageScrollChanged" PointerWheelChanged="OnChatScrollInteraction">
                  <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="message" Classes.local="{Binding IsLocal}">
                          <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                              <TextBlock Text="{Binding Sender}" FontSize="12" FontWeight="SemiBold" Foreground="#0F6CBD" />
                              <TextBlock Grid.Column="1" Text="{Binding Time}" Classes="caption" />
                            </Grid>
                            <TextBlock Text="{Binding Text}" FontSize="14" Foreground="#242424" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <Button x:Name="GoToRemoteButton" Grid.Row="2" Content="前往远程节点" IsVisible="{Binding !IsConnected}"
                        Classes="secondary" Command="{Binding NavigateCommand}" CommandParameter="1"
                        HorizontalAlignment="Center" Margin="0,8,0,0" />
              </Grid>
            </Border>
            <Border Grid.Row="1" Classes="surface" Padding="10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBox x:Name="MessageInput" Text="{Binding MessageDraft}" PlaceholderText="输入消息，Enter 发送，Shift+Enter 换行…" AcceptsReturn="True" MinHeight="72" MaxHeight="160" VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Classes="primary" Content="发送" Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </Grid>
          <!-- Node status -->
          <ScrollViewer Grid.Row="1" IsVisible="{Binding IsStatusPage}" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
              <Border Classes="surface" Padding="22">
                <StackPanel Spacing="12">
                  <TextBlock Classes="section-title" Text="节点状态" />
                  <TextBlock Classes="muted" Text="查看当前节点和连接的实时状态。" />
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="10">
                    <TextBlock Text="本机节点" Classes="caption" />
                    <TextBlock Grid.Column="1" Text="{Binding NodeStatus}" Foreground="#242424" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="远程连接" Classes="caption" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConnectionStatus}" Foreground="#242424" />
                  </Grid>
                </StackPanel>
              </Border>
              <Border Classes="surface" Padding="22">
                <StackPanel Spacing="8">
                  <TextBlock Classes="section-title" Text="运行日志" />
                  <TextBox Classes="code" Text="{Binding Log}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="280" FontSize="12" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <!-- Agent roles -->
          <ScrollViewer Grid.Row="1" IsVisible="{Binding IsRolesPage}" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
              <Border Classes="surface" Padding="22">
                <StackPanel Spacing="14">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4"><TextBlock Classes="section-title" Text="角色设定"/><TextBlock Classes="muted" Text="每个 Agent 实例对应一个独立聊天框，右键可以编辑资料。"/></StackPanel>
                    <Button Grid.Column="1" Classes="secondary" Content="刷新" Command="{Binding RefreshAgentsCommand}"/>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Agents}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Border Classes="subtle-surface" Width="270" Margin="0,0,12,12" Padding="14">
                        <Border.ContextMenu>
                          <ContextMenu Opened="OnAgentMenuOpened">
                            <MenuItem Header="进入聊天" Click="OnAgentChatMenuClick"/>
                            <MenuItem Header="设置信息" Click="OnAgentSettingsMenuClick"/>
                          </ContextMenu>
                        </Border.ContextMenu>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                          <Border Width="48" Height="48" CornerRadius="24" Background="#DDEBFF"><TextBlock Text="✦" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0F6CBD"/></Border>
                          <StackPanel Grid.Column="1" Spacing="3" Margin="0,0,58,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Provider}" Classes="caption"/><TextBlock Text="{Binding Role}" Classes="muted"/><TextBlock Text="{Binding Status}" Classes="caption"/></StackPanel>
                          <Button Grid.Column="1" Classes="secondary" Content="激活" Command="{Binding DataContext.ActivateCodexCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding CanActivate}" />
                        </Grid>
                      </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="muted" IsVisible="{Binding !HasAgents}" Text="未发现运行中的 Agent。请在设置中接入 Codex、Claude Code、Cursor 或其他 MCP 客户端。" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <!-- Application settings -->
          <ScrollViewer Grid.Row="1" IsVisible="{Binding IsSettingsPage}" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
              <Border Classes="surface" Padding="22">
                <StackPanel Spacing="12">
                  <TextBlock Classes="section-title" Text="应用设置" />
                  <TextBlock Classes="muted" Text="配置设备名称和本地身份信息。设置会保存在当前用户的应用数据目录。" />
                  <TextBlock Classes="caption" Text="设备名称" />
                  <TextBox Text="{Binding Settings.DisplayName}" PlaceholderText="设备名称" />
                  <Button Classes="primary" Content="保存设置" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
              <Border Classes="surface" Padding="22">
                <StackPanel Spacing="10"><TextBlock Classes="section-title" Text="MCP 客户端接入"/><TextBlock Classes="muted" Text="将 AgentLink MCP 写入客户端配置。重启或新建客户端会话后，调用 agentlink_register 注册实际 Agent。"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Classes="secondary" Content="接入 Codex" Command="{Binding EnableCodexMcpCommand}"/><Button Classes="secondary" Content="接入 Claude Code" Command="{Binding EnableClaudeMcpCommand}"/><Button Classes="secondary" Content="接入 Cursor" Command="{Binding EnableCursorMcpCommand}"/></StackPanel></StackPanel>
              </Border>
              <Border Classes="surface" Padding="22">
                <StackPanel Spacing="8">
                  <TextBlock Classes="section-title" Text="关于 AgentLink" />
                  <TextBlock Classes="muted" Text="AgentLink 使用 Iroh QUIC、Relay 与 NAT 穿透能力实现跨网络节点通信。" />
                  <TextBlock Classes="caption" Text="当前版本 0.3.6 · Windows 原生风格界面" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.RowSpan="2" Background="#60000000" IsVisible="{Binding IsAgentChatOpen}">
      <Border Classes="surface" Width="560" Height="520" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
          <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Classes="section-title" Text="Agent 聊天"/><TextBlock Classes="muted" Text="{Binding SelectedAgent.Name}"/></StackPanel><Button Grid.Column="1" Content="关闭" Classes="secondary" Command="{Binding CloseAgentChatCommand}"/></Grid>
          <ScrollViewer x:Name="AgentChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" PointerWheelChanged="OnChatScrollInteraction"><ItemsControl ItemsSource="{Binding AgentChatMessages}"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="message" Classes.local="{Binding IsLocal}" Margin="0,0,0,8"><StackPanel Spacing="3"><TextBlock Text="{Binding Sender}" Classes="caption"/><TextBlock Text="{Binding Text}" TextWrapping="Wrap"/><TextBlock Text="{Binding Time}" Classes="caption"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding AgentChatDraft}" PlaceholderText="输入消息"/><Button Grid.Column="1" Content="发送" Classes="primary" Command="{Binding SendAgentChatCommand}" IsEnabled="{Binding CanSendAgentChat}"/></Grid>
        </Grid>
      </Border>
    </Border>
    <Border Grid.RowSpan="2" Background="#60000000" IsVisible="{Binding IsProfileDialogOpen}">
      <Border Classes="surface" Width="460" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12"><TextBlock Classes="section-title" Text="编辑 Agent 资料"/><TextBlock Classes="caption" Text="默认头像（6 个）"/>
          <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="✦" Classes="secondary" CommandParameter="0"/><Button Content="●" Classes="secondary" CommandParameter="1"/><Button Content="◆" Classes="secondary" CommandParameter="2"/><Button Content="●" Classes="secondary" CommandParameter="3"/><Button Content="✚" Classes="secondary" CommandParameter="4"/><Button Content="✿" Classes="secondary" CommandParameter="5"/></StackPanel>
          <TextBox Text="{Binding ProfileName}" PlaceholderText="名字"/><TextBox Text="{Binding ProfileRole}" PlaceholderText="职位"/><TextBox Text="{Binding ProfileDescription}" PlaceholderText="职位详细信息" AcceptsReturn="True" MinHeight="80"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Content="取消" Classes="secondary" Command="{Binding CloseProfileDialogCommand}"/><Button Content="保存" Classes="primary" Command="{Binding SaveAgentProfileCommand}"/></StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <Border Grid.RowSpan="2" Background="#60000000" IsVisible="{Binding IsAgentIntegrationPromptOpen}">
      <Border Classes="surface" Width="500" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Spacing="14"><TextBlock Classes="section-title" Text="接入 MCP Agent？"/><TextBlock Classes="muted" Text="可在设置中将 AgentLink MCP 写入 Codex、Claude Code 或 Cursor。接入后请在对应客户端调用 agentlink_register 注册实际 Agent。"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Classes="secondary" Content="暂不接入" Command="{Binding DeclineCodexMcpCommand}"/><Button Classes="primary" Content="前往设置" Command="{Binding NavigateCommand}" CommandParameter="4"/></StackPanel></StackPanel></Border>
    </Border>
    <Border Grid.RowSpan="2" Background="#60000000" IsVisible="{Binding IsActivationPromptOpen}">
      <Border Classes="surface" Width="500" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Spacing="14"><TextBlock Classes="section-title" Text="激活 Codex？"/><TextBlock Classes="muted" Text="激活会关闭当前 Codex 对话窗口和正在运行的 Codex 程序，然后重新启动 Codex 并创建一个新的 AgentLink 激活任务。未保存的交互可能丢失。"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Classes="secondary" Content="取消" Command="{Binding CancelActivationCommand}"/><Button Classes="primary" Content="确认激活" Command="{Binding ConfirmActivationCommand}"/></StackPanel></StackPanel></Border>
    </Border>
    <!-- Modal overlay blocks duplicate actions until the real connection result arrives. -->
    <Border Grid.RowSpan="2" Background="#60000000" IsVisible="{Binding IsConnectionDialogOpen}">
      <Border Classes="surface" Width="360" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="20" HorizontalAlignment="Stretch">
          <Path Classes="connect-spinner" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center"
                IsVisible="{Binding IsConnecting}" Stroke="#0F6CBD" StrokeThickness="3" StrokeLineCap="Round"
                Data="M 16,2 A 14,14 0 1 1 2,16" RenderTransformOrigin="50%,50%">
            <Path.RenderTransform><RotateTransform /></Path.RenderTransform>
          </Path>
          <TextBlock Text="{Binding ConnectionPrompt}" FontSize="16" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Stretch" />
          <Button Content="确定" Classes="secondary" IsVisible="{Binding !IsConnecting}"
                  Command="{Binding CloseConnectionDialogCommand}" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
